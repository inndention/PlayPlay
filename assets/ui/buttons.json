{
  "about": [
    "PlayPlay button system: the single source of truth for the native app and the web dashboard (docs/plans/ux-buttons.md section 3).",
    "Edit this file or icons.json, then regenerate: cmake -P tools/uispec/gen_uispec.cmake (or build the gen_uispec target).",
    "That writes Play_Play_Native/qml/PlayPlay/Buttons/spec.js, web/ui-spec.js, web/icons.svg and web/ui-tokens.css. Never edit those by hand:",
    "test_uispec fails while any of them differs from a fresh generation.",
    "Every top-level key except 'about' becomes a var of spec.js and an export of ui-spec.js. Objects come out with sorted keys, so a list",
    "whose order matters has its own *Order array. A colour reference names a Theme.qml token listed in 'theme' (bg3, onAir, ...); 'warn' as a",
    "colour is Theme.warn (yellow), while the role 'warn' paints Theme.standby (amber).",
    "ui-tokens.css: theme entries marked new, --role-*, --btn-* (sizes, states, timing) and --led-*; keys ending in Ms get ms, keys ending in",
    "W / H / Size / Offset / Gap / Radius and every numeric size token get px, other numbers stay unitless, and strings that are not colours",
    "(layout, sublabel text) stay out of the CSS.",
    "Glyph keys are matched after dropping U+FE0F (emoji presentation selector). safetyDefaults: the top-level fields describe the action, or its",
    "'on' state for a stateful action (playing, armed, engine running); 'off' overrides fields for the other state. 'web' is empty where the web",
    "dashboard has no such key. The floor is the lowest level a user may set; levels are ordered as in safetyLevels."
  ],
  "version": 1,

  "theme": {
    "bg0":     { "css": "bg0",     "hex": "#05050a" },
    "bg1":     { "css": "bg1",     "hex": "#0a0a12" },
    "bg2":     { "css": "bg2",     "hex": "#0f0f18" },
    "bg3":     { "css": "bg3",     "hex": "#141420" },
    "bg4":     { "css": "bg4",     "hex": "#1a1a28" },
    "bg5":     { "css": "bg5",     "hex": "#22223a" },
    "border0": { "css": "b0",      "hex": "#1f1f35" },
    "border1": { "css": "b1",      "hex": "#2a2a40" },
    "border2": { "css": "b2",      "hex": "#3f3f60" },
    "text0":   { "css": "t0",      "hex": "#f0f0f8" },
    "text1":   { "css": "t1",      "hex": "#a0a0b8" },
    "text2":   { "css": "t2",      "hex": "#707088" },
    "text3":   { "css": "t3",      "hex": "#505068" },
    "accent0": { "css": "accent",  "hex": "#00d4ff" },
    "accent2": { "css": "accent2", "hex": "#a855f7" },
    "onAir":   { "css": "onair",   "hex": "#ff2d55" },
    "standby": { "css": "standby", "hex": "#ff9500" },
    "ready":   { "css": "ready",   "hex": "#30d158" },
    "cued":    { "css": "cued",    "hex": "#5e5ce6" },
    "warn":    { "css": "warn",    "hex": "#ffd60a" },
    "danger":  { "css": "danger",  "hex": "#ff453a" },
    "info":    { "css": "info",    "hex": "#0a84ff", "new": true }
  },

  "sizes": {
    "xs": { "h": 20, "minW": 20,  "padX": 6,  "font": 10, "tracking": 0.6, "icon": 12, "radius": 3, "gap": 4, "layout": "row" },
    "s":  { "h": 24, "minW": 24,  "padX": 8,  "font": 11, "tracking": 0.4, "icon": 13, "radius": 5, "gap": 6, "layout": "row" },
    "m":  { "h": 30, "minW": 30,  "padX": 11, "font": 12, "tracking": 0.4, "icon": 15, "radius": 5, "gap": 6, "layout": "row" },
    "l":  { "h": 46, "minW": 64,  "padX": 8,  "font": 10, "tracking": 0.8, "icon": 20, "radius": 5, "gap": 1, "layout": "stacked", "subFont": 9 },
    "xl": { "h": 58, "minW": 104, "padX": 10, "font": 12, "tracking": 0.4, "icon": 22, "radius": 8, "gap": 2, "layout": "stacked", "subFont": 10 }
  },
  "sizeOrder": ["xs", "s", "m", "l", "xl"],

  "roles": {
    "neutral":     { "color": "text1",   "label": "Neutral" },
    "primary":     { "color": "accent0", "label": "Primary" },
    "go":          { "color": "ready",   "label": "Go" },
    "stop":        { "color": "onAir",   "label": "Stop (on air)" },
    "destructive": { "color": "danger",  "label": "Delete" },
    "warn":        { "color": "standby", "label": "Warn" },
    "info":        { "color": "info",    "label": "Info" },
    "accent":      { "color": "accent2", "label": "Accent" },
    "cued":        { "color": "cued",    "label": "Cued" }
  },
  "roleOrder": ["neutral", "primary", "go", "stop", "destructive", "warn", "info", "accent", "cued"],

  "fills": {
    "solid":   { "bg": "tint", "border": "",        "text": "onFill", "icon": "onFill" },
    "tonal":   { "bg": "tint", "border": "tint",    "text": "tint",   "icon": "tint", "bgA": 0.18 },
    "outline": { "bg": "",     "border": "border1", "text": "text0",  "icon": "text1" },
    "ghost":   { "bg": "",     "border": "",        "text": "text1",  "icon": "text1" }
  },
  "fillOrder": ["solid", "tonal", "outline", "ghost"],
  "autoFill": { "neutral": "outline", "neutralBg": "bg3", "coloured": "solid", "ghost": "ghost", "active": "tonal" },
  "legacyVariants": {
    "default": { "role": "neutral", "fill": "auto" },
    "primary": { "role": "primary", "fill": "auto" },
    "success": { "role": "go",      "fill": "auto" },
    "danger":  { "role": "stop",    "fill": "auto" },
    "warn":    { "role": "warn",    "fill": "auto" },
    "info":    { "role": "info",    "fill": "auto" },
    "accent2": { "role": "accent",  "fill": "auto" },
    "ghost":   { "role": "neutral", "fill": "ghost" }
  },

  "states": {
    "onFill": "bg0",
    "labelWeight": 700,
    "hoverK": 1.12,
    "pressK": 1.25,
    "hoverBg": "bg4",
    "pressBg": "bg5",
    "hoverBorder": "border2",
    "litA": 0.30,
    "litBorderW": 2,
    "disabledBg": "bg3",
    "disabledBgLarge": "bg2",
    "disabledBorder": "border0",
    "disabledText": "text3",
    "focusColor": "accent0",
    "focusW": 2,
    "focusOffset": 2,
    "armColor": "standby",
    "armW": 2,
    "armPulseHz": 2,
    "armPulseMin": 0.45,
    "armBarH": 3,
    "armSublabel": "CONFIRM",
    "holdA": 0.35,
    "busyLabelA": 0.6,
    "errorColor": "danger",
    "errorMs": 600
  },
  "timing": { "armMs": 3000, "holdMs": 800, "minIntervalMs": 250, "animMs": 90, "tipDelayMs": 600 },

  "leds": {
    "colors": { "red": "onAir", "green": "ready", "amber": "standby", "blue": "info" },
    "meaning": {
      "red": "on air now (PGM)",
      "green": "preview / ready / armed and healthy",
      "amber": "armed to confirm, cued, warning",
      "blue": "info / selected for control"
    },
    "tally": { "pgm": "red", "pvw": "green" },
    "barH": 4,
    "dotSize": 6,
    "blinkHz": { "none": 0, "slow": 1, "fast": 4 }
  },

  "swatches": ["#ff2d55", "#ff9500", "#30d158", "#5e5ce6", "#ffd60a", "#ff453a", "#5856d6", "#ff9f0a",
               "#bf5af2", "#64d2ff", "#ff375f", "#ac8e68", "#f0f0f8", "#a0a0b8", "#707088", "#3f3f60"],

