  "reservedKeys": {
    "global":   ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "Space", "Ctrl+Right", "Ctrl+L", "Ctrl+=", "Ctrl++", "Ctrl+-", "Ctrl+0",
                 "Ctrl+C", "Ctrl+X", "Ctrl+V", "Delete"],
    "onair":    ["1", "2", "3", "4", "5", "6", "7", "8", "Alt+1", "Alt+2", "Alt+3", "Alt+4", "Alt+5", "Alt+6", "Alt+7", "Alt+8",
                 "Ctrl+Return", "Ctrl+Enter", "Ctrl+Shift+Return", "Ctrl+Shift+Enter", "Escape"],
    "schedule": ["Escape"]
  },
  "hotkeyRules": {
    "modifierOrder": ["Ctrl", "Alt", "Shift", "Meta", "Num"],
    "aliases": { "Esc": "Escape", "Del": "Delete", "Ins": "Insert", "Control": "Ctrl", "Option": "Alt", "Cmd": "Meta", "Win": "Meta",
                 "Page Up": "PgUp", "Page Down": "PgDown", "PageUp": "PgUp", "PageDown": "PgDown", "Spacebar": "Space" },
    "allowedNative": "^(F(9|1[0-2])|(Ctrl|Alt|Shift|Ctrl\\+Shift)\\+[A-Z0-9]|Num\\+([0-9]|[*/.+-]|Enter))$",
    "allowedWeb": "^([A-Z0-9]|F(9|1[0-2])|(Ctrl|Alt|Shift|Ctrl\\+Shift)\\+[A-Z0-9]|Num\\+([0-9]|[*/.+-]|Enter))$"
  },

  "safetyLevels": ["none", "arm", "hold", "modal"],
