import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import ".."
import "../ui"

/// As-Played report: Supervisor as_run rows with planned vs actual variance, summary, CSV copy.
Item {
    id: view
    property var rows: []
    property var summary: ({})
    property string channel: supervisor.activeChannelId
    property var from: new Date(new Date().setHours(0, 0, 0, 0))
    property var to: new Date(new Date().setHours(23, 59, 59, 0))
    property string typeFilter: ""
    property string mode: "played"
    function reload() {
        api.get("/asrun?channel=" + channel + "&from=" + from.getTime() + "&to=" + to.getTime() + "&limit=2000", function(ok, data) {
            if (ok) { view.rows = data.rows || []; view.summary = data.summary || {} }
        })
    }
    function shiftDay(n) { from = new Date(from.getTime() + n * 86400000); to = new Date(to.getTime() + n * 86400000); reload() }
    function csv() {
        var s = "Planned,Actual,Variance s,Event,Status,Title,Type,Origin,Duration s\n"
        for (var i = 0; i < rows.length; ++i) { var r = rows[i]
            s += [r.plannedStart || "", r.actualStart || "", r.eventType === "START" ? (r.varianceMs / 1000).toFixed(2) : "", r.eventType, r.status, '"' + (r.title || "").replace(/"/g, '""') + '"', r.type, r.origin, r.actualDurationMs ? (r.actualDurationMs / 1000).toFixed(1) : ""].join(",") + "\n" }
        clip.text = s; clip.selectAll(); clip.copy(); window.toast("CSV copied (" + rows.length + " rows)", "ok")
    }
    // --- Reports panel state: branded HTML / CSV reports are generated by the Supervisor under /reports/* ------
    property var channelIds: ["all"]
    property var matches: []
    property string pickedId: ""
    property var compareIds: []
    property string assetSummary: ""
    function qs(o) { var p = []; for (var k in o) if (o[k] !== "" && o[k] !== undefined && o[k] !== null) p.push(encodeURIComponent(k) + "=" + encodeURIComponent(o[k])); return p.length ? "?" + p.join("&") : "" }
    // /reports/* sits behind the same bearer token as /api/ (the Supervisor answers 401 without ?token=): every URL handed to the system
    // browser carries it. api.rawUrl() appends it itself for /api/ and /preview/ (and, once SupervisorApi covers /reports/, for these too).
    function repUrl(path) {
        var h = path.indexOf("#"), frag = h >= 0 ? path.substring(h) : "", base = h >= 0 ? path.substring(0, h) : path
        var u = api.rawUrl(base)
        if (api.token && u.indexOf("token=") < 0) u += (u.indexOf("?") < 0 ? "?" : "&") + "token=" + encodeURIComponent(api.token)
        return u + frag
    }
    function openReport(name, params, fmt) { Qt.openUrlExternally(view.repUrl("/reports/" + name + "." + (fmt || "html") + qs(params))) }
    function repChannel() { return repChan.currentText === "all" ? "" : repChan.currentText }
    function periodParams() { return { period: repPeriod.currentText, date: repDate.text, group: repGroup.currentText, channel: repChannel() || "all" } }
    // The search box fires on every keystroke and each hit runs a (channel-less) asset report on the Supervisor's single thread: debounce it.
    property string pendingSearch: ""
    function searchAssets(q) { view.pendingSearch = q; searchTimer.restart() }
    function runAssetSearch() {
        var q = view.pendingSearch
        if (q.trim().length < 2) { view.matches = []; return }
        api.get("/media?q=" + encodeURIComponent(q.trim()) + "&limit=12", function(ok, d) {
            if (!ok || q !== view.pendingSearch) return            // a newer search superseded this one
            view.matches = (d.media || []).map(function(m) { return { id: m.id, title: (m.title || m.id) + "  ·  " + (m.type || "") } })
            if (view.matches.length) view.loadAssetSummary(view.matches[0].id); else { view.pickedId = ""; view.assetSummary = "" }
        })
    }
    function loadAssetSummary(id) {
        view.pickedId = id; view.assetSummary = "loading…"
        api.get("/reports/asset/" + encodeURIComponent(id) + "?days=7", function(ok, d) {       // a week is plenty for the one-line summary (the full report opens with 30 days)
            if (view.pickedId !== id) return                       // another asset was picked meanwhile
            if (!ok || !d || !d.totals) { view.assetSummary = "no data"; return }
            var t = d.totals
            view.assetSummary = (t.airings || 0) + " airings / 7 d · " + Theme.fmtClock(t.airtimeSec || 0) + " · on-time " + (t.onTimePct === null || t.onTimePct === undefined ? "—" : Number(t.onTimePct).toFixed(0) + "%")
                + " · upcoming " + ((t.upcomingDirect || 0) + (t.upcomingViaBlock || 0)) + (d.neverAired ? " · NEVER AIRED" : "")
        })
    }
    function loadChannels() { api.get("/channels", function(ok, d) { if (ok) view.channelIds = ["all"].concat((d.channels || []).map(function(c) { return c.profile ? c.profile.id : c.id })) }) }
    onChannelIdsChanged: { var i = channelIds.indexOf(view.channel); repChan.currentIndex = i >= 0 ? i : 0 }
    function hourUrl(row) {
        var ms = row.actualStartMs || row.plannedStartMs || Date.now(); var d = new Date(ms); var day = Qt.formatDate(d, "yyyy-MM-dd")
        return view.repUrl("/reports/asplayed.html?channel=" + encodeURIComponent(row.channelId || view.channel) + "&date=" + day + "#h-" + day + "-" + d.getHours())
    }
    Menu {
        id: rowMenu
        property var row: ({})
        MenuItem { text: "Asset report ↗"; enabled: !!(rowMenu.row && rowMenu.row.assetId); onTriggered: { Qt.openUrlExternally(view.repUrl("/reports/asset/" + encodeURIComponent(rowMenu.row.assetId) + ".html?days=30")) } }
        MenuItem { text: "This hour in the as-played report ↗"; onTriggered: { Qt.openUrlExternally(view.hourUrl(rowMenu.row)) } }
        MenuItem { text: "Add to compare"; enabled: !!(rowMenu.row && rowMenu.row.assetId) && view.compareIds.indexOf(rowMenu.row.assetId) < 0 && view.compareIds.length < 4; onTriggered: { view.compareIds = view.compareIds.concat([rowMenu.row.assetId]); window.toast("Compare: " + view.compareIds.length + " asset(s)", "ok") } }
        MenuItem { text: "Open in library"; enabled: !!(rowMenu.row && rowMenu.row.assetId); onTriggered: { window.openMedia(rowMenu.row.assetId) } }
    }

    Component.onCompleted: { reload(); loadChannels() }
    Connections { target: supervisor; function onAsRun(ch, row) { if (ch === view.channel) reloadTimer.restart() } }
    Timer { id: reloadTimer; interval: 1500; onTriggered: { view.reload() } }
    Timer { id: searchTimer; interval: 300; onTriggered: { view.runAssetSearch() } }
    TextEdit { id: clip; visible: false }
    property var filtered: typeFilter.length ? rows.filter(function(r) { return r.eventType === typeFilter }) : rows

    ColumnLayout {
        anchors.fill: parent
        spacing: 10
        Rectangle {
            Layout.fillWidth: true; implicitHeight: 44; color: Theme.bg2; radius: Theme.r8; border.color: Theme.border0
            RowLayout {
                anchors.fill: parent; anchors.leftMargin: 12; anchors.rightMargin: 12; spacing: 8
                CButton { text: "As Played"; small: true; variant: "ghost"; active: view.mode === "played"; onClicked: { view.mode = "played" } }
                CButton { text: "As Scheduled"; small: true; variant: "ghost"; active: view.mode === "scheduled"; onClicked: { view.mode = "scheduled" } }
                CBadge { text: view.channel; tint: Theme.accent0 }
                Item { width: 12 }
                CButton { icon2: "‹"; small: true; onClicked: { view.shiftDay(-1) } }
                Text { text: Qt.formatDate(view.from, "dddd, MMM d yyyy"); color: Theme.accent0; font.pixelSize: Theme.fs12; font.bold: true }
                CButton { icon2: "›"; small: true; onClicked: { view.shiftDay(1) } }
                Item { Layout.fillWidth: true }
                Repeater { model: [["", "All"], ["START", "Starts"], ["END", "Ends"], ["SKIP", "Skips"], ["FAILED", "Failed"], ["CG_SHOW", "CG"]]
                    CButton { text: modelData[1]; small: true; variant: "ghost"; active: view.typeFilter === modelData[0]; onClicked: { view.typeFilter = modelData[0] } } }
                CButton { text: "Copy CSV"; small: true; icon2: "⎘"; onClicked: { view.csv() } }
                CButton { icon2: "↻"; small: true; variant: "ghost"; onClicked: { view.reload() } }
            }
        }
        RowLayout {
            Layout.fillWidth: true; spacing: 10
            Repeater {
                model: [ ["EVENTS", String(view.rows.length)], ["STARTS", String(view.summary.events || 0)], ["ON TIME", String(view.summary.onTime || 0)], ["LATE", String(view.summary.late || 0)], ["FAILED", String(view.summary.failed || 0)], ["SKIPPED", String(view.summary.skipped || 0)], ["FILL", String(view.summary.fill || 0)], ["ON TIME %", (view.summary.onTimePct !== undefined ? Number(view.summary.onTimePct).toFixed(0) : "100") + "%"], ["AVG |VAR|", ((view.summary.avgAbsVarianceMs || 0) / 1000).toFixed(2) + " s"] ]
                Rectangle { Layout.fillWidth: true; implicitHeight: 54; color: Theme.bg2; radius: Theme.r8; border.color: Theme.border0
                    Column { anchors.centerIn: parent; spacing: 0
                        Text { anchors.horizontalCenter: parent.horizontalCenter; text: modelData[1]; color: modelData[0] === "FAILED" && modelData[1] !== "0" ? Theme.danger : modelData[0] === "LATE" && modelData[1] !== "0" ? Theme.standby : Theme.text0; font.family: Theme.fontMono; font.pixelSize: Theme.fs20; font.bold: true }
                        Text { anchors.horizontalCenter: parent.horizontalCenter; text: modelData[0]; color: Theme.text3; font.pixelSize: Theme.fs10; font.bold: true; font.letterSpacing: 1 } } }
            }
        }
        // --- Reports: branded print-ready HTML / CSV generated by the Supervisor; every button opens the system browser ---
        CPanel {
            Layout.fillWidth: true; Layout.preferredHeight: 128; title: "Reports — branded HTML / CSV (opens in the browser)"
            headerRight: [ CButton { text: "Index ↗"; small: true; variant: "ghost"; onClicked: { Qt.openUrlExternally(view.repUrl("/reports/index.html")) } } ]
            ColumnLayout {
                anchors.fill: parent; anchors.margins: 10; anchors.topMargin: 6; spacing: 6
                RowLayout {
                    Layout.fillWidth: true; spacing: 8
                    CSelect { id: repPeriod; Layout.preferredWidth: 104; model: ["daily", "weekly", "monthly", "quarterly"]; currentIndex: 1 }
                    CField { id: repDate; Layout.preferredWidth: 104; text: Qt.formatDate(view.from, "yyyy-MM-dd"); placeholder: "yyyy-MM-dd"; mono: true }
                    CSelect { id: repGroup; Layout.preferredWidth: 104; model: ["all", "type", "client", "series", "category"] }
                    CSelect { id: repChan; Layout.preferredWidth: 120; model: view.channelIds }
                    CButton { text: "Period ↗"; small: true; variant: "primary"; onClicked: { view.openReport("full", view.periodParams()) } ToolTip.visible: hovered; ToolTip.text: "Totals, breakdown by group, per-channel subtotals, top 25, failures, narrative" }
                    CButton { text: "CSV"; small: true; variant: "ghost"; onClicked: { view.openReport("full", view.periodParams(), "csv") } }
                    CButton { text: "As-played ↗"; small: true; onClicked: { view.openReport("asplayed", { channel: view.repChannel() || "all", date: repDate.text }) } }
                    CField { id: repTol; Layout.preferredWidth: 54; text: "90"; mono: true; ToolTip.visible: false }
                    CButton { text: "Adherence ↗"; small: true; onClicked: { if (!view.repChannel()) { window.toast("Adherence needs one channel", "warn"); return } view.openReport("adherence", { channel: view.repChannel(), date: repDate.text, toleranceSec: repTol.text }) } }
                    CButton { text: "Contracts ↗"; small: true; onClicked: { view.openReport("contracts", { date: repDate.text }) } }
                    CButton { text: "Top ↗"; small: true; onClicked: { view.openReport("top", { days: 30, n: 25, channel: view.repChannel() || "all" }) } }
                    Item { Layout.fillWidth: true }
                }
                RowLayout {
                    Layout.fillWidth: true; spacing: 8
                    CField { id: repSearch; Layout.preferredWidth: 260; placeholder: "asset report: search title / id / series / client"; onEdited: function(v) { view.searchAssets(v) } }
                    CSelect { id: repMatch; Layout.preferredWidth: 300; model: view.matches; textRole: "title"; enabled: view.matches.length > 0; onActivated: function(i) { if (view.matches[i]) view.loadAssetSummary(view.matches[i].id) } }
                    CButton { text: "Asset report ↗"; small: true; variant: "primary"; enabled: view.pickedId.length > 0; onClicked: { Qt.openUrlExternally(view.repUrl("/reports/asset/" + encodeURIComponent(view.pickedId) + ".html?days=30")) } }
                    CButton { text: "+ Compare"; small: true; variant: "ghost"; enabled: view.pickedId.length > 0 && view.compareIds.indexOf(view.pickedId) < 0 && view.compareIds.length < 4; onClicked: { view.compareIds = view.compareIds.concat([view.pickedId]) } }
                    CButton { text: "Compare " + view.compareIds.length + " ↗"; small: true; enabled: view.compareIds.length > 1; onClicked: { view.openReport("compare", { ids: view.compareIds.join(","), days: 30 }) } }
                    CButton { text: "Clear"; small: true; variant: "ghost"; visible: view.compareIds.length > 0; onClicked: { view.compareIds = [] } }
                    Text { Layout.fillWidth: true; text: view.assetSummary; color: Theme.text2; font.pixelSize: Theme.fs11; elide: Text.ElideRight }
                }
            }
        }
        AsScheduledTable { visible: view.mode === "scheduled"; Layout.fillWidth: true; Layout.fillHeight: true; channel: view.channel; day: view.from }
        CPanel {
            visible: view.mode === "played"
            Layout.fillWidth: true; Layout.fillHeight: true; padding: 0
            title: view.filtered.length + " rows"
            Rectangle { id: hdr; width: parent.width; height: 26; color: Theme.bg1
                RowLayout { anchors.fill: parent; anchors.leftMargin: 10; anchors.rightMargin: 10; spacing: 8
                    Repeater { model: [["PLANNED", 86], ["ACTUAL", 86], ["VAR", 56], ["EVENT", 70], ["STATUS", 90], ["TITLE", -1], ["TYPE", 70], ["ORIGIN", 70], ["DUR", 60], ["TC", 90]]
                        Text { text: modelData[0]; color: Theme.text3; font.pixelSize: Theme.fs10; font.bold: true; font.letterSpacing: 1; Layout.preferredWidth: modelData[1] > 0 ? modelData[1] : -1; Layout.fillWidth: modelData[1] < 0 } } } }
            ListView {
                anchors.fill: parent; anchors.topMargin: 26; clip: true; model: view.filtered
                ScrollBar.vertical: ScrollBar {}
                delegate: Rectangle {
                    width: ListView.view.width; height: 26; color: index % 2 ? Theme.bg2 : Theme.bg3
                    property real v: (modelData.varianceMs || 0) / 1000
                    MouseArea { anchors.fill: parent; acceptedButtons: Qt.RightButton; onClicked: function(m) { if (m.button === Qt.RightButton) { rowMenu.row = modelData; rowMenu.popup() } } }
                    RowLayout { anchors.fill: parent; anchors.leftMargin: 10; anchors.rightMargin: 10; spacing: 8
                        Text { text: modelData.plannedStartMs ? Theme.fmtTime(modelData.plannedStartMs, true) : "—"; color: Theme.text1; font.family: Theme.fontMono; font.pixelSize: Theme.fs11; Layout.preferredWidth: 86 }
                        Text { text: modelData.actualStartMs ? Theme.fmtTime(modelData.actualStartMs, true) : "—"; color: Theme.text0; font.family: Theme.fontMono; font.pixelSize: Theme.fs11; Layout.preferredWidth: 86 }
                        Text { text: modelData.eventType === "START" ? (v > 0 ? "+" : "") + v.toFixed(2) : ""; color: Math.abs(v) > 1 ? Theme.standby : Theme.text2; font.family: Theme.fontMono; font.pixelSize: Theme.fs11; Layout.preferredWidth: 56 }
                        Text { text: modelData.eventType || ""; color: modelData.eventType === "START" ? Theme.ready : modelData.eventType === "FAILED" ? Theme.danger : Theme.text1; font.pixelSize: Theme.fs11; font.bold: true; Layout.preferredWidth: 70 }
                        CBadge { text: modelData.status || ""; tint: modelData.status === "ON_TIME" ? Theme.ready : modelData.status === "LATE_START" ? Theme.standby : modelData.status === "FAILED" ? Theme.danger : Theme.text2; Layout.preferredWidth: 90 }
                        Text { text: modelData.title || ""; color: Theme.text0; font.pixelSize: Theme.fs11; elide: Text.ElideRight; Layout.fillWidth: true }
                        Text { text: modelData.type || ""; color: Theme.typeColor(modelData.type); font.pixelSize: Theme.fs10; Layout.preferredWidth: 70 }
                        Text { text: modelData.origin || ""; color: Theme.text2; font.pixelSize: Theme.fs10; Layout.preferredWidth: 70 }
                        Text { text: modelData.actualDurationMs ? Theme.fmtClock(modelData.actualDurationMs / 1000) : ""; color: Theme.text1; font.family: Theme.fontMono; font.pixelSize: Theme.fs11; Layout.preferredWidth: 60 }
                        Text { text: modelData.timecode || ""; color: Theme.text3; font.family: Theme.fontMono; font.pixelSize: Theme.fs10; Layout.preferredWidth: 90 } }
                }
                Text { anchors.centerIn: parent; visible: view.filtered.length === 0; text: "No as-run events for this day"; color: Theme.text3; font.pixelSize: Theme.fs11 }
            }
        }
    }
}
