# gen_uispec.cmake: generates the button system's committed outputs from its single source of truth
# (docs/plans/ux-buttons.md section 3.3). A cmake -P script, so it needs no Python or Node:
#
#   cmake -P tools/uispec/gen_uispec.cmake                   rewrite the outputs in the source tree (only those that changed)
#   cmake -DOUT_DIR=<dir> -P tools/uispec/gen_uispec.cmake   write the same files under <dir> instead (test_uispec does this)
#
# Building the gen_uispec target runs the first form.
# Inputs:  assets/ui/buttons.json   tokens, theme names, glyph map, reserved keys, safety defaults (see its "about")
#          assets/ui/icons.json     in-house 24x24 icons: { name: { d: [path...], fd: [filled path...], fill, sw, tags, origin } }
# Outputs: Play_Play_Native/qml/PlayPlay/Buttons/spec.js   .pragma library: one var per buttons.json key, plus icons
#          web/ui-spec.js                                  ES module: the same values as exports
#          web/icons.svg                                   sprite of <symbol id="i-NAME" viewBox="0 0 24 24">
#          web/ui-tokens.css                               :root custom properties (--info, --role-*, --btn-*, --led-*)
# Each icon comes out as { stroke, fill, sw, tags }: "stroke" paths are stroked only; "fill" paths (d of a fill:true icon, plus
# any fd) are filled and also stroked with the same width and round joins, which rounds their corners.
#
# The output is deterministic and independent of the CMake version: object members are emitted sorted (string(JSON) keeps
# them in a sorted map anyway, and sorting here does not rely on that), numbers are re-formatted (jsoncpp prints 0.6 as
# 0.59999999999999998), and files are written with LF line ends only when their content changed.
cmake_minimum_required(VERSION 3.21)

get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT DEFINED SRC_DIR)
    set(SRC_DIR "${_root}")
endif()
if(NOT DEFINED OUT_DIR)
    set(OUT_DIR "${SRC_DIR}")
endif()

function(_uispec_fail msg)
    message(FATAL_ERROR "gen_uispec: ${msg}")
endfunction()

# JS / JSON string literal of <str>: backslash, quote and control characters escaped; other UTF-8 is kept as it is.
function(_uispec_jsstr str outvar)
    string(REPLACE "\\" "\\\\" str "${str}")
    string(REPLACE "\"" "\\\"" str "${str}")
    string(REPLACE "\n" "\\n" str "${str}")
    string(REPLACE "\r" "\\r" str "${str}")
    string(REPLACE "\t" "\\t" str "${str}")
    set(${outvar} "\"${str}\"" PARENT_SCOPE)
endfunction()

# A number as string(JSON GET) prints it, rounded to at most 6 decimals with trailing zeros dropped (0.59999999999999998 -> 0.6,
# 2.0 -> 2). Exponent notation is refused: no token needs it.
function(_uispec_num raw outvar)
    if(raw MATCHES "^-?[0-9]+$")
        set(${outvar} "${raw}" PARENT_SCOPE)
        return()
    endif()
    if(NOT raw MATCHES "^(-?)([0-9]+)\\.([0-9]+)$")
        _uispec_fail("number '${raw}' is not a plain decimal")
    endif()
    set(sign "${CMAKE_MATCH_1}")
    set(ip "${CMAKE_MATCH_2}")
    set(fp "${CMAKE_MATCH_3}")
    string(LENGTH "${fp}" n)
    if(n GREATER 6)
        string(SUBSTRING "${fp}" 0 6 f6)
        string(SUBSTRING "${fp}" 6 1 d7)
        string(REGEX REPLACE "^0+([0-9])" "\\1" ipn "${ip}")   # no leading zeros into math(EXPR)
        string(REGEX REPLACE "^0+([0-9])" "\\1" f6n "${f6}")
        math(EXPR v "${ipn} * 1000000 + ${f6n}")
        if(d7 GREATER_EQUAL 5)
            math(EXPR v "${v} + 1")
        endif()
        math(EXPR ip "${v} / 1000000")
        math(EXPR fr "${v} % 1000000")
        set(fp "000000${fr}")
        string(LENGTH "${fp}" l)
        math(EXPR l "${l} - 6")
        string(SUBSTRING "${fp}" ${l} 6 fp)
    endif()
    string(REGEX REPLACE "0+$" "" fp "${fp}")
    if(fp STREQUAL "")
        set(r "${sign}${ip}")
    else()
        set(r "${sign}${ip}.${fp}")
    endif()
    if(r STREQUAL "-0")
        set(r "0")
    endif()
    set(${outvar} "${r}" PARENT_SCOPE)
endfunction()

# JS literal of one scalar: <type> and <raw> as string(JSON TYPE / GET) give them (booleans come back as ON / OFF).
function(_uispec_scalar type raw outvar)
    if(type STREQUAL "STRING")
        _uispec_jsstr("${raw}" v)
    elseif(type STREQUAL "NUMBER")
        _uispec_num("${raw}" v)
    elseif(type STREQUAL "BOOLEAN")
        if(raw)
            set(v "true")
        else()
            set(v "false")
        endif()
    else()
        set(v "null")
    endif()
    set(${outvar} "${v}" PARENT_SCOPE)
endfunction()

# Sorted member names of the JSON object <json>, as a CMake list. Names that would break a CMake list are refused.
function(_uispec_keys json outvar)
    string(JSON n LENGTH "${json}")
    set(keys "")
    if(n GREATER 0)
        math(EXPR last "${n} - 1")
        foreach(i RANGE ${last})
            string(JSON k MEMBER "${json}" ${i})
            if(k STREQUAL "" OR k MATCHES ";" OR k MATCHES "\\[" OR k MATCHES "\\]" OR k MATCHES "\\\\")
                _uispec_fail("key '${k}' is empty or holds ; [ ] or a backslash")
            endif()
            list(APPEND keys "${k}")
        endforeach()
        list(SORT keys)
    endif()
    set(${outvar} "${keys}" PARENT_SCOPE)
endfunction()

# JS literal (also valid JSON) of the object or array <json>, members sorted, nested containers indented from <ind>. A container
# of scalars goes on one line when it fits in 140 columns; a longer array of scalars is packed into lines; anything else gets one
# item per line. Items are joined as strings, never as CMake lists, because JSON text may hold semicolons.
function(_uispec_js json ind outvar)
    string(JSON type TYPE "${json}")
    if(type STREQUAL "OBJECT")
        _uispec_keys("${json}" keys)
    else()
        string(JSON n LENGTH "${json}")
        set(keys "")
        if(n GREATER 0)
            math(EXPR last "${n} - 1")
            foreach(i RANGE ${last})
                list(APPEND keys ${i})
            endforeach()
        endif()
    endif()
    if(keys STREQUAL "")
        if(type STREQUAL "OBJECT")
            set(${outvar} "{}" PARENT_SCOPE)
        else()
            set(${outvar} "[]" PARENT_SCOPE)
        endif()
        return()
    endif()
    set(ind2 "${ind}  ")
    set(scalars TRUE)
    set(first TRUE)
    foreach(k IN LISTS keys)
        string(JSON ct TYPE "${json}" "${k}")
        if(ct STREQUAL "OBJECT" OR ct STREQUAL "ARRAY")
            string(JSON sub GET "${json}" "${k}")
            _uispec_js("${sub}" "${ind2}" v)
            set(scalars FALSE)
        else()
            string(JSON raw GET "${json}" "${k}")
            _uispec_scalar("${ct}" "${raw}" v)
        endif()
        if(type STREQUAL "OBJECT")
            _uispec_jsstr("${k}" kq)
            set(v "${kq}: ${v}")
        endif()
        if(first)
            set(flat "${v}")
            set(multi "${ind2}${v}")
            set(line "${v}")
            set(packed "")
            set(first FALSE)
        else()
            string(APPEND flat ", ${v}")
            string(APPEND multi ",\n${ind2}${v}")
            string(LENGTH "${ind2}${line}, ${v}," ll)
            if(ll GREATER 132)
                string(APPEND packed "${ind2}${line},\n")
                set(line "${v}")
            else()
                string(APPEND line ", ${v}")
            endif()
        endif()
    endforeach()
    string(APPEND packed "${ind2}${line}")
    if(type STREQUAL "OBJECT")
        set(one "{ ${flat} }")
        set(open "{")
        set(close "}")
    else()
        set(one "[${flat}]")
        set(open "[")
        set(close "]")
    endif()
    string(LENGTH "${ind}${one}" ol)
    if(scalars AND ol LESS_EQUAL 140)
        set(r "${one}")
    elseif(scalars AND type STREQUAL "ARRAY")
        set(r "${open}\n${packed}\n${ind}${close}")
    else()
        set(r "${open}\n${multi}\n${ind}${close}")
    endif()
    set(${outvar} "${r}" PARENT_SCOPE)
endfunction()

# Path strings of one icon member ("d" or "fd") joined with a space; empty when the member is absent.
function(_uispec_paths icon name member outvar)
    string(JSON t ERROR_VARIABLE err TYPE "${icon}" ${member})
    set(r "")
    if(NOT err)
        if(NOT t STREQUAL "ARRAY")
            _uispec_fail("icon '${name}': ${member} must be an array of path strings")
        endif()
        string(JSON n LENGTH "${icon}" ${member})
        if(n GREATER 0)
            math(EXPR last "${n} - 1")
            foreach(i RANGE ${last})
                string(JSON p GET "${icon}" ${member} ${i})
                string(STRIP "${p}" p)
                if(p STREQUAL "" OR p MATCHES "[\"<>&]" OR p MATCHES "\\\\")
                    _uispec_fail("icon '${name}': ${member}[${i}] is empty or holds a quote, <, >, & or backslash")
                endif()
                if(r STREQUAL "")
                    set(r "${p}")
                else()
                    string(APPEND r " ${p}")
                endif()
            endforeach()
        endif()
    endif()
    set(${outvar} "${r}" PARENT_SCOPE)
endfunction()

# var(--x) for a theme colour name (bg3, onAir ...); refuses names the theme table does not list.
function(_uispec_css_color ref outvar)
    if(NOT DEFINED _th_css_${ref})
        _uispec_fail("'${ref}' is not a colour of the theme table")
    endif()
    set(${outvar} "var(--${_th_css_${ref}})" PARENT_SCOPE)
endfunction()

# CSS custom properties for the flat object <json>: --<prefix><kebab-key>. Numbers get ms (keys ending in Ms), px (W, H, Size,
# Offset, Gap, Radius) or no unit; theme colour names become var(); other strings (text, layout names) stay out of the CSS.
function(_uispec_css_tokens json prefix outvar)
    _uispec_keys("${json}" keys)
    set(r "")
    foreach(k IN LISTS keys)
        string(JSON t TYPE "${json}" "${k}")
        string(REGEX REPLACE "([A-Z])" "-\\1" kk "${k}")
        string(TOLOWER "${kk}" kk)
        if(t STREQUAL "NUMBER")
            string(JSON v GET "${json}" "${k}")
            _uispec_num("${v}" v)
            if(k MATCHES "Ms$")
                set(v "${v}ms")
            elseif(k MATCHES "(W|H|Size|Offset|Gap|Radius)$")
                set(v "${v}px")
            endif()
        elseif(t STREQUAL "STRING")
            string(JSON v GET "${json}" "${k}")
            if(NOT DEFINED _th_css_${v})
                continue()
            endif()
            set(v "var(--${_th_css_${v}})")
        else()
            continue()
        endif()
        string(APPEND r "  --${prefix}${kk}: ${v};\n")
    endforeach()
    set(${outvar} "${r}" PARENT_SCOPE)
endfunction()

# Writes <OUT_DIR>/<rel> with LF line ends unless it already holds <content> (CRLF from a git checkout counts as the same).
function(_uispec_write rel content)
    set(path "${OUT_DIR}/${rel}")
    set(state "wrote")
    if(EXISTS "${path}")
        file(READ "${path}" old)
        string(REPLACE "\r\n" "\n" old "${old}")
        if(old STREQUAL content)
            set(state "unchanged")
        endif()
    endif()
    if(state STREQUAL "wrote")
        get_filename_component(dir "${path}" DIRECTORY)
        file(MAKE_DIRECTORY "${dir}")
        # file(CONFIGURE) rather than file(WRITE), for its guaranteed LF line ends. @ONLY with a template that is just the
        # variable copies the content verbatim (nothing in it is substituted). It ends the file with a newline of its own, so it
        # gets the content without its last one; the read-back catches a CMake that behaves otherwise.
        string(REGEX REPLACE "\n$" "" body "${content}")
        file(CONFIGURE OUTPUT "${path}" CONTENT "@body@" @ONLY NEWLINE_STYLE UNIX)
        file(READ "${path}" back)
        if(NOT back STREQUAL content)
            file(CONFIGURE OUTPUT "${path}" CONTENT "@content@" @ONLY NEWLINE_STYLE UNIX)
            file(READ "${path}" back)
            if(NOT back STREQUAL content)
                _uispec_fail("could not write ${rel} verbatim")
            endif()
        endif()
    endif()
    message(STATUS "gen_uispec: ${state} ${rel}")
endfunction()

# ---------------------------------------------------------------------------------------------------------------------------
file(READ "${SRC_DIR}/assets/ui/buttons.json" B)
file(READ "${SRC_DIR}/assets/ui/icons.json" I)
string(JSON _t ERROR_VARIABLE _e TYPE "${B}")
if(_e OR NOT _t STREQUAL "OBJECT")
    _uispec_fail("assets/ui/buttons.json is not a JSON object: ${_e}")
endif()
string(JSON _t ERROR_VARIABLE _e TYPE "${I}")
if(_e OR NOT _t STREQUAL "OBJECT")
    _uispec_fail("assets/ui/icons.json is not a JSON object: ${_e}")
endif()

# Theme table: Theme.qml name -> style.css custom property and hex. Entries marked "new" are defined by ui-tokens.css.
string(JSON _theme GET "${B}" theme)
_uispec_keys("${_theme}" _tnames)
set(_th_new "")
foreach(_n IN LISTS _tnames)
    if(NOT _n MATCHES "^[A-Za-z][A-Za-z0-9]*$")
        _uispec_fail("theme name '${_n}' is not an identifier")
    endif()
    string(JSON _css GET "${_theme}" "${_n}" css)
    string(JSON _hex GET "${_theme}" "${_n}" hex)
    set(_th_css_${_n} "${_css}")
    set(_th_hex_${_n} "${_hex}")
    string(JSON _new ERROR_VARIABLE _e GET "${_theme}" "${_n}" new)
    if(NOT _e AND _new)
        list(APPEND _th_new "${_n}")
    endif()
endforeach()

set(_note "GENERATED by tools/uispec/gen_uispec.cmake from assets/ui/buttons.json and assets/ui/icons.json; do not edit.")
set(_how "Change the JSON and run: cmake -P tools/uispec/gen_uispec.cmake (test_uispec fails while this file is stale).")
set(_qml ".pragma library\n// ${_note}\n// ${_how}\n")
set(_web "// ${_note}\n// ${_how}\n")

# One var / export per buttons.json key ("about" is documentation only).
_uispec_keys("${B}" _top)
foreach(_k IN LISTS _top)
    if(_k STREQUAL "about")
        continue()
    endif()
    if(NOT _k MATCHES "^[A-Za-z_][A-Za-z0-9_]*$" OR _k STREQUAL "icons")
        _uispec_fail("buttons.json key '${_k}' is not usable as a JS name (and 'icons' is reserved for icons.json)")
    endif()
    string(JSON _ct TYPE "${B}" "${_k}")
    if(_ct STREQUAL "OBJECT" OR _ct STREQUAL "ARRAY")
        string(JSON _sub GET "${B}" "${_k}")
        _uispec_js("${_sub}" "" _v)
    else()
        string(JSON _raw GET "${B}" "${_k}")
        _uispec_scalar("${_ct}" "${_raw}" _v)
    endif()
    string(APPEND _qml "\nvar ${_k} = ${_v};\n")
    string(APPEND _web "\nexport const ${_k} = ${_v};\n")
endforeach()

# Icons: one line each in the JS, one <symbol> each in the sprite.
_uispec_keys("${I}" _names)
set(_icons "")
set(_sep "")
set(_svg "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"0\" height=\"0\" style=\"position:absolute;width:0;height:0;overflow:hidden\" aria-hidden=\"true\">\n")
string(APPEND _svg "<!-- ${_note} ${_how} -->\n")
foreach(_n IN LISTS _names)
    string(LENGTH "${_n}" _len)
    if(NOT _n MATCHES "^[a-z0-9-]+$" OR _len GREATER 32)
        _uispec_fail("icon name '${_n}' must match [a-z0-9-]{1,32}")
    endif()
    string(JSON _ic GET "${I}" "${_n}")
    _uispec_paths("${_ic}" "${_n}" d _d)
    _uispec_paths("${_ic}" "${_n}" fd _fd)
    if(_d STREQUAL "")
        _uispec_fail("icon '${_n}' has no d paths")
    endif()
    string(JSON _fill ERROR_VARIABLE _e GET "${_ic}" fill)
    if(_e)
        set(_fill OFF)
    endif()
    string(JSON _sw ERROR_VARIABLE _e GET "${_ic}" sw)
    if(_e)
        set(_sw 1.75)
    endif()
    _uispec_num("${_sw}" _sw)
    if(_fill)
        set(_stroke "")
        set(_filled "${_d}")
        if(NOT _fd STREQUAL "")
            string(APPEND _filled " ${_fd}")
        endif()
    else()
        set(_stroke "${_d}")
        set(_filled "${_fd}")
    endif()
    string(JSON _tags ERROR_VARIABLE _e GET "${_ic}" tags)
    if(_e)
        set(_tags "[]")
    endif()
    _uispec_js("${_tags}" "  " _tagsjs)
    _uispec_jsstr("${_n}" _nq)
    string(APPEND _icons "${_sep}  ${_nq}: { \"stroke\": \"${_stroke}\", \"fill\": \"${_filled}\", \"sw\": ${_sw}, \"tags\": ${_tagsjs} }")
    set(_sep ",\n")
    string(APPEND _svg "  <symbol id=\"i-${_n}\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"${_sw}\""
                       " stroke-linecap=\"round\" stroke-linejoin=\"round\">")
    if(NOT _stroke STREQUAL "")
        string(APPEND _svg "<path d=\"${_stroke}\"/>")
    endif()
    if(NOT _filled STREQUAL "")
        string(APPEND _svg "<path d=\"${_filled}\" fill=\"currentColor\"/>")
    endif()
    string(APPEND _svg "</symbol>\n")
endforeach()
string(APPEND _svg "</svg>\n")
string(APPEND _qml "\nvar icons = {\n${_icons}\n};\n")
string(APPEND _web "\nexport const icons = {\n${_icons}\n};\n")

# ui-tokens.css
set(_cssout "/* ${_note}\n   ${_how} */\n:root {\n")
foreach(_n IN LISTS _tnames)
    if(_n IN_LIST _th_new)
        string(APPEND _cssout "  --${_th_css_${_n}}: ${_th_hex_${_n}};\n")
    endif()
endforeach()
string(JSON _roles GET "${B}" roles)
_uispec_keys("${_roles}" _rnames)
foreach(_r IN LISTS _rnames)
    string(JSON _c GET "${_roles}" "${_r}" color)
    _uispec_css_color("${_c}" _cv)
    string(APPEND _cssout "  --role-${_r}: ${_cv};\n")
endforeach()
string(JSON _sizes GET "${B}" sizes)
string(JSON _nso LENGTH "${B}" sizeOrder)
math(EXPR _last "${_nso} - 1")
foreach(_i RANGE ${_last})
    string(JSON _s GET "${B}" sizeOrder ${_i})
    string(JSON _sz ERROR_VARIABLE _e GET "${_sizes}" "${_s}")
    if(_e)
        _uispec_fail("sizeOrder names '${_s}', which sizes does not define")
    endif()
    _uispec_keys("${_sz}" _fields)
    foreach(_f IN LISTS _fields)
        string(JSON _ft TYPE "${_sz}" "${_f}")
        if(_ft STREQUAL "NUMBER")
            string(JSON _v GET "${_sz}" "${_f}")
            _uispec_num("${_v}" _v)
            string(REGEX REPLACE "([A-Z])" "-\\1" _kk "${_f}")
            string(TOLOWER "${_kk}" _kk)
            string(APPEND _cssout "  --btn-${_kk}-${_s}: ${_v}px;\n")
        endif()
    endforeach()
endforeach()
string(JSON _states GET "${B}" states)
_uispec_css_tokens("${_states}" "btn-" _tok)
string(APPEND _cssout "${_tok}")
string(JSON _timing GET "${B}" timing)
_uispec_css_tokens("${_timing}" "btn-" _tok)
string(APPEND _cssout "${_tok}")
string(JSON _leds GET "${B}" leds)
string(JSON _lc GET "${_leds}" colors)
_uispec_keys("${_lc}" _lnames)
foreach(_l IN LISTS _lnames)
    string(JSON _c GET "${_lc}" "${_l}")
    _uispec_css_color("${_c}" _cv)
    string(APPEND _cssout "  --led-${_l}: ${_cv};\n")
endforeach()
string(JSON _v GET "${_leds}" barH)
string(APPEND _cssout "  --led-bar-h: ${_v}px;\n")
string(JSON _v GET "${_leds}" dotSize)
string(APPEND _cssout "  --led-dot-size: ${_v}px;\n")
string(JSON _blink GET "${_leds}" blinkHz)
_uispec_keys("${_blink}" _bnames)
foreach(_b IN LISTS _bnames)
    string(JSON _hz GET "${_blink}" "${_b}")
    if(NOT _hz MATCHES "^[0-9]+$")
        _uispec_fail("leds.blinkHz.${_b} must be a whole number")
    endif()
    if(_hz GREATER 0)
        math(EXPR _ms "1000 / ${_hz}")
        string(APPEND _cssout "  --led-blink-${_b}: ${_ms}ms;\n")
    endif()
endforeach()
string(APPEND _cssout "}\n")

_uispec_write("Play_Play_Native/qml/PlayPlay/Buttons/spec.js" "${_qml}")
_uispec_write("web/ui-spec.js" "${_web}")
_uispec_write("web/icons.svg" "${_svg}")
_uispec_write("web/ui-tokens.css" "${_cssout}")
